          "avx512" = [ "vpclmulqdq" ];
          "default" = [ "std" "c-allocator" ];
          "quickcheck" = [ "dep:quickcheck" ];
          "std" = [ "rust-allocator" ];
        };
        resolvedDefaultFeatures = [ "rust-allocator" ];
      };
      "zmij" = rec {
        crateName = "zmij";
        version = "1.0.23";
        edition = "2021";
        sha256 = "06zwri21nnrl34rwinmvbciap8yk1mrl8qfg9pff7lgspc56sri9";
        authors = [
          "David Tolnay <dtolnay@gmail.com>"
        ];
        features = {
          "no-panic" = [ "dep:no-panic" ];
        };
      };
      "zstd" = rec {
        crateName = "zstd";
        version = "0.14.3";
        edition = "2018";
        sha256 = "0w1wzfxmypnq1f1p7s0g8abn7ba6zkp7wxpggccl0vmgj2zyjfnv";
        authors = [
          "Alexandre Bury <alexandre.bury@gmail.com>"
        ];
        dependencies = [
          {
            name = "zstd-safe";
            packageId = "zstd-safe";
